---
import { ArrowUpRight } from '@lucide/astro';
import ProjectImage from './ProjectImage.astro';
const { project, number, compact = false } = Astro.props;
---
<a class:list={['project-card', { compact }]} href={project.url ?? `/${project.id}/`} target={project.url ? '_blank' : undefined} rel={project.url ? 'noopener noreferrer' : undefined}>
  <div class:list={['project-visual', project.color, project.id]}>
    <span class="visual-label">{project.context}</span>
    <ProjectImage sizes="(max-width:700px) calc(100vw - 40px), (max-width:1100px) calc((100vw - 94px) / 2), (max-width:1512px) calc((100vw - 142px) / 2), 685px" name={project.cover} alt={project.coverAlt ?? `${project.client} — ${project.category}`} />
  </div>
  <div class="project-meta"><span class="eyebrow">{String(number).padStart(2, '0')} / {project.category}</span>{project.year && <span>{project.year}</span>}</div>
  <h3><span>{project.title}</span></h3>
  <p class="project-action">{project.url ? 'Visit project' : 'View case study'}{project.url && <ArrowUpRight class="project-title-arrow" size={18} aria-hidden="true" />}<span class="sr-only">{project.url ? ' (opens in a new tab)' : ''}</span></p>
</a>

<style>
  .project-card .project-visual { aspect-ratio:1 / 1; }
  .project-action { display:flex; align-items:center; gap:6px; margin:12px 0 0; font-size:var(--type-small); color:var(--muted); }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
</style>
