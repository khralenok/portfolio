<header>
  <div id="logo">
    <a href="/">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="96"
        height="24"
        fill="none"
        viewBox="0 0 96 24"
      >
        <path
          stroke="#fff"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m84 6 1 13m6-14-6 9m-8-9c4 0 4 7 4 7s0 7-4 7-4-7-4-7 0-7 4-7M64 19 63 5l6 14 1-13m-20 8 10-1s0-8-4-8-4 7-4 7 0 7 4 7l4-2M47 6l-1 13h5m-16 0 3-14 5 14m-10-6 6 2m53 4-5-7M24 5s8-1 8 3-6 5-6 5l6 6m-7 0V8m-13 6h8m-5 5L14 6m6 13 1-14M4 5l1 14m6-13-6 8m7 5-5-7"
        ></path>
      </svg>
    </a>
  </div>
  <input id="menu-toggle" type="checkbox" aria-label="Toggle navigation menu" />
  <label class="menu-button" for="menu-toggle" title="Toggle navigation menu">
    <span></span>
    <span></span>
    <span></span>
  </label>
  <nav aria-label="Main navigation">
    <ul>
      <li><a href="#workflow">How I work</a></li>
      <li><a href="#cases">Cases</a></li>
      <li><a href="#knowhow">Know-how</a></li>
      <li><a href="#faq">FAQ</a></li>
    </ul>
    <a class="inquire mobile-cta" href="mailto:khralenok.g@gmail.com">Inquire</a
    >
  </nav>
  <div id="actions">
    <a class="inquire desktop-cta" href="mailto:khralenok.g@gmail.com"
      >Inquire</a
    >
  </div>
</header>

<script>
  const menuToggle = document.querySelector<HTMLInputElement>("#menu-toggle");
  const menuLinks =
    document.querySelectorAll<HTMLAnchorElement>("header nav a");

  menuLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (menuToggle) menuToggle.checked = false;
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuToggle?.checked) {
      menuToggle.checked = false;
      menuToggle.focus();
    }
  });
</script>

<style>
  header {
    --header-height: 5rem;
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) auto minmax(10rem, 1fr);
    align-items: center;
    position: sticky;
    top: 0;
    font-family: var(--font-inter);
    font-size: 1.25rem;
    z-index: 100;
    padding: 0 var(--page-gutter);
    min-height: var(--header-height);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  #logo {
    display: flex;
    align-items: center;
  }

  #logo a {
    display: flex;
    border-radius: var(--radius-sm);

    background: var(--color-accent);
  }

  #logo svg {
    height: calc(24px * 2);
    width: calc(96px * 2);
  }

  ul {
    display: flex;
    list-style: none;
    gap: clamp(1.25rem, 3vw, 3rem);
    justify-content: center;
  }

  ul a {
    position: relative;
    display: inline-block;
    padding-block: 0.25rem;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  ul a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    border-radius: 999px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 160ms ease;
  }

  #actions {
    display: flex;
    justify-content: right;
  }

  a:link,
  :visited {
    text-decoration: none;
    color: inherit;
  }

  .inquire {
    font: inherit;
    background: var(--color-accent);
    color: var(--color-neutral-0)!important;
    border: 0;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    display: inline-flex;
    transition:
      background-color 160ms ease,
      transform 160ms ease;
  }

  ul a:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  ul a:hover::after {
    transform: scaleX(1);
  }

  .inquire:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  #menu-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .menu-button,
  .mobile-cta {
    display: none;
  }

  @media (max-width: 52rem) {
    header {
      --header-height: 4.5rem;
      grid-template-columns: 1fr auto;
      gap: 1rem;
      min-height: var(--header-height);
    }

    #logo svg {
      width: 9rem;
      height: 2.25rem;
    }

    #actions {
      display: none;
    }

    .menu-button {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0.625rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      cursor: pointer;
      background: var(--color-surface);
    }

    .menu-button span {
      display: block;
      width: 100%;
      height: 2px;
      border-radius: 999px;
      background: var(--color-text);
      transition:
        opacity 180ms ease,
        transform 180ms ease;
    }

    #menu-toggle:focus-visible + .menu-button {
      outline: 3px solid var(--color-3);
      outline-offset: 3px;
    }

    #menu-toggle:checked + .menu-button span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    #menu-toggle:checked + .menu-button span:nth-child(2) {
      opacity: 0;
    }

    #menu-toggle:checked + .menu-button span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    nav {
      position: fixed;
      inset: var(--header-height) 0 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding: clamp(2rem, 7vw, 4rem) var(--page-gutter);
      background: var(--color-surface);
      overflow-y: auto;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-0.75rem);
      transition:
        opacity 180ms ease,
        transform 220ms ease,
        visibility 220ms;
    }

    #menu-toggle:checked ~ nav {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    ul {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      font-size: clamp(1.5rem, 6vw, 2rem);
      font-weight: 600;
    }

    ul a {
      display: block;
      padding: 1rem 0;
      border-bottom: 1px solid var(--color-border);
    }

    ul a::after {
      right: auto;
      width: 2rem;
    }

    .mobile-cta {
      display: flex;
      align-self: flex-start;
      justify-content: center;
      margin-top: 2rem;
      min-width: 10rem;
      padding: 0.875rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ul a,
    ul a::after,
    .inquire,
    .menu-button span,
    nav {
      transition: none;
    }
  }
</style>

<style is:global>
  @media (max-width: 52rem) {
    body:has(#menu-toggle:checked) {
      overflow: hidden;
    }
  }
</style>
