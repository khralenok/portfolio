---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const sources = import.meta.glob<{ default: ImageMetadata }>('../images/selected/*', { eager: true });
const { name, alt, eager = false, class: className = '', width = 1200, animated } = Astro.props;
const source = sources[`../images/selected/${name}`]?.default;
if (!source) throw new Error(`Missing selected image: ${name}`);
---
{animated ? <picture class="animated-artwork">
  <source srcset={animated} media="(prefers-reduced-motion: no-preference)" type="image/webp" />
  <Image src={source} alt={alt} width={Math.min(width, source.width)} format="webp" quality={85} loading={eager ? 'eager' : 'lazy'} decoding="async" class={className} />
</picture> : <Image src={source} alt={alt} width={Math.min(width, source.width)} widths={[400, 800, 1200].filter(w => w <= source.width)} sizes="(max-width: 700px) 100vw, (max-width: 1200px) 50vw, 700px" format="webp" quality={85} loading={eager ? 'eager' : 'lazy'} decoding="async" class={className} />}
