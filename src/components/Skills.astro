---
import { Camera } from '@lucide/astro'
---

<section id="skills">
  <h2>What I do</h2>
  <div class="card">
    <Camera size={72}/>
    <h3>Daily design tasks</h3>
    <p>Decks, posts, covers, newsletters you name it.</p>
  </div>
  <div class="card">
    <Camera size={72}/>
    <h3>Brand systems</h3>
    <p>Good design not rush, it rests on its pillars</p>
  </div>
  <div class="card">
    <Camera size={72}/>
    <h3>Design automation</h3>
    <p>My rule of thumb – automate what you can, but keep it editable</p>
  </div>
  <div class="card">
    <Camera size={72}/>
    <h3>Illustration</h3>
    <p>Language that have almost no language bariers.</p>
  </div>
</section>

<style>
  section {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto 1fr;
  }

  h2 {
    grid-column: span 4;
    text-align: center;
  }
</style>
