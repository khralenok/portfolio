---
import type { IllustrationImage } from './illustration/images';
import { imageSource } from './illustration/images';
export interface Props {
  images: IllustrationImage[];
  columns?: number;
  gap?: string;
  label?: string;
  thumbnailPosition?: string;
}
const { images, columns = 3, gap = '8px', label = 'Illustration gallery', thumbnailPosition = 'center' } = Astro.props;
const count = Number.isFinite(columns) ? Math.max(1, Math.floor(columns)) : 3;
const items = await Promise.all(images.map(async image => ({
  ...image,
  thumb: await imageSource(image.thumbnail ?? image.src, 640),
  full: await imageSource(image.src, 2400),
})));
---
<illustration-gallery style={`--columns:${count};--gap:${gap};--thumbnail-position:${thumbnailPosition}`}>
  <div class="grid" role="group" aria-label={label}>
    {items.map((image, i) => <button class="thumbnail" type="button" aria-label={`Open image ${i + 1}: ${image.alt}`} aria-haspopup="dialog" data-src={image.full.src} data-alt={image.alt} data-caption={image.caption ?? ''}>
      <img {...image.thumb} alt={image.alt} loading="lazy" decoding="async" />
    </button>)}
  </div>
  <dialog aria-label={label}>
    <div class="lightbox">
      <div class="toolbar"><span class="counter" aria-live="polite" aria-atomic="true"></span><button type="button" data-close autofocus aria-label="Close gallery">Close ×</button></div>
      <div class="stage"><img class="full" alt="" draggable="false" /></div>
      <div class="navigation"><button type="button" data-prev aria-label="Previous image">←</button><p class="caption"></p><button type="button" data-next aria-label="Next image">→</button></div>
    </div>
  </dialog>
</illustration-gallery>
<script>
  import { attachSwipe } from './illustration/swipe';
  class IllustrationGallery extends HTMLElement {
    private cleanup?: AbortController;
    private closeGallery?: () => void;
    connectedCallback() {
      this.cleanup?.abort();
      const controller = this.cleanup = new AbortController();
      const options = { signal: controller.signal };
      const dialog = this.querySelector('dialog')!;
      const thumbnails = Array.from(this.querySelectorAll<HTMLButtonElement>('.thumbnail'));
      const image = this.querySelector<HTMLImageElement>('.full')!;
      const previous = this.querySelector<HTMLButtonElement>('[data-prev]')!;
      const next = this.querySelector<HTMLButtonElement>('[data-next]')!;
      let index = 0;
      let origin: HTMLButtonElement | undefined;
      let overflow = '';
      const show = (position: number) => {
        index = Math.max(0, Math.min(thumbnails.length - 1, position));
        const data = thumbnails[index].dataset;
        image.src = data.src!;
        image.alt = data.alt!;
        this.querySelector('.counter')!.textContent = `${index + 1} / ${thumbnails.length}`;
        this.querySelector('.caption')!.textContent = data.caption!;
        // Keep navigation focus stable at either end of the collection.
        previous.setAttribute('aria-disabled', String(index === 0));
        next.setAttribute('aria-disabled', String(index === thumbnails.length - 1));
      };
      const restore = () => {
        if (!origin) return;
        document.documentElement.style.overflow = overflow;
        image.removeAttribute('src');
        origin.focus({ preventScroll: true });
        origin = undefined;
      };
      this.closeGallery = () => { if (dialog.open) dialog.close(); restore(); };
      thumbnails.forEach((button, i) => button.addEventListener('click', () => {
        if (dialog.open) return;
        origin = button;
        overflow = document.documentElement.style.overflow;
        show(i);
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      }, options));
      this.querySelector('[data-close]')!.addEventListener('click', this.closeGallery, options);
      dialog.addEventListener('close', restore, options);
      dialog.addEventListener('cancel', event => { event.preventDefault(); this.closeGallery!(); }, options);
      let backdropDown = false;
      dialog.addEventListener('pointerdown', event => { backdropDown = event.target === dialog; }, options);
      dialog.addEventListener('click', event => { if (backdropDown && event.target === dialog) this.closeGallery!(); }, options);
      previous.addEventListener('click', () => show(index - 1), options);
      next.addEventListener('click', () => show(index + 1), options);
      dialog.addEventListener('keydown', event => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); show(index + (event.key === 'ArrowRight' ? 1 : -1)); }
        if (event.key === 'Tab') {
          const buttons = Array.from(dialog.querySelectorAll<HTMLButtonElement>('button'));
          const first = buttons[0], last = buttons[buttons.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
      }, options);
      attachSwipe(this.querySelector('.stage')!, delta => show(index + delta), controller.signal);
    }
    disconnectedCallback() { this.closeGallery?.(); this.cleanup?.abort(); }
  }
  if (!customElements.get('illustration-gallery')) customElements.define('illustration-gallery', IllustrationGallery);
</script>
<style>
  illustration-gallery { display:block; min-width:0; }
  .grid { display:grid; grid-template-columns:repeat(var(--columns),minmax(0,1fr)); gap:var(--gap); }
  button { font:inherit; color:inherit; cursor:pointer; min-width:44px; min-height:44px; border:1px solid var(--line); border-radius:3px; background:var(--paper); }
  button:focus-visible { outline:3px solid var(--color-red); outline-offset:3px; }
  .thumbnail { padding:0; overflow:hidden; aspect-ratio:1; transition:opacity .18s; }
  .thumbnail:hover { opacity:.8; }
  .thumbnail img { width:100%; height:100%; object-fit:cover; object-position:var(--thumbnail-position); }
  dialog { position:fixed; inset:0; margin:auto; width:calc(100% - 32px); max-width:1400px; height:calc(100dvh - 32px); max-height:100%; border:0; padding:0; background:var(--paper); color:var(--ink); border-radius:3px; overflow:hidden; }
  dialog::backdrop { background:color-mix(in srgb,var(--ink) 90%,transparent); }
  .lightbox { height:100%; display:grid; grid-template-rows:auto minmax(0,1fr) auto; padding:max(12px,env(safe-area-inset-top)) max(12px,env(safe-area-inset-right)) max(12px,env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left)); gap:12px; }
  .toolbar,.navigation { display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:var(--type-small); }
  .toolbar button { padding:8px 16px; }
  .stage { min-height:0; touch-action:pan-y; }
  .full { width:100%; height:100%; object-fit:contain; }
  .caption { text-align:center; max-height:4.5em; overflow:auto; line-height:1.5; }
  [aria-disabled=true] { opacity:.4; }
  @media(prefers-reduced-motion:reduce) { .thumbnail { transition:none; } }
</style>
