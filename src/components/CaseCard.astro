---
// CaseCard.astro

interface Props {
  title: string;
  niche: string;
  scope: string;
  image: string;
  href: string;
}

const { title, niche, scope, image, href } = Astro.props;
---

<a href={href} class="case-thumbnail" style="cursor: pointer;">
  <div class="case-cover">
    <img src={image} alt={title} />
  </div>
  <div class="case-details">
    <div>
      <div class="case-title">{title}</div>
      <div class="case-niche">{niche}</div>
    </div>
    <div>
      <div class="case-scope">{scope}</div>
      <div>[view]</div>
    </div>
  </div>
</a>

<style>
  .case-thumbnail {
    display: block;
    flex-direction: column;
    flex: 1 1 0%;
    color: var(--color-neutral-40);
  }

  .case-thumbnail a {
    color: var(--color-neutral-80);
  }

  .case-thumbnail:nth-child(2) {
    border-left: var(--standard-border);
    border-right: var(--standard-border);
  }

  .case-title {
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: calc(var(--base-size)*0.01);
    color: var(--color-neutral-80);
  }

  .case-details {
    display: flex;
    flex-direction: column;
    gap: calc(var(--base-size)*0.5);
    padding: var(--base-size);
  }

  .case-details > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .case-cover {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .case-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease-in-out;
  }

  .case-thumbnail:hover {
    color: var(--color-neutral-100);
  }

  .case-thumbnail:hover a {
    color: var(--color-accent-100);
  }

  .case-thumbnail:hover img {
    transform: scale(1.15);
  }

  .case-niche,
  .case-scope {
    font-size: calc(var(--base-size)*0.8);
  }
</style>
