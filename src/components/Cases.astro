---
import CaseCard from "../components/CaseCard.astro";

const cases = [
  {
    title: "Cryptonix",
    niche: "FinTech, B2B",
    scope: "Branding, Design System, Visuals",
    image: "/src/images/cryptonix.jpg",
    href: "/cryptonix",
  },
  {
    title: "Crowd Control",
    niche: "MarTech, B2B",
    scope: "Branding, Design System, Mascot",
    image: "/src/images/cc.jpg",
    href: "/crowd-control",
  },
  {
    title: "Zvuk Business",
    niche: "MarTech, B2B",
    scope: "Branding, Design System, Illustrations",
    image: "/src/images/zvuk.jpg",
    href: "/zvuk",
  },
];

const actualCases = [];

for (const item of cases) {
  if (item.href != Astro.url.pathname) {
    actualCases.push(item);
  }
}
---

<section id="cases">
  {
    actualCases.map((item) => (
      <CaseCard
        title={item.title}
        niche={item.niche}
        scope={item.scope}
        image={item.image}
        href={item.href}
      />
    ))
  }
</section>

<style>
  section {
    display: flex;
  }

  @media (max-width: 1024px) {
    section {
      flex-direction: column;
    }
  }
</style>
