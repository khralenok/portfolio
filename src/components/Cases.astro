---
const cases = [
  {
    title: "Cryptonix",
    niche: "FinTech, B2B",
    scope: "Branding, Design System, Visuals",
    image: "/img/cryptonix.jpg",
    href: "/cryptonix",
  },
  {
    title: "Crowd Control",
    niche: "MarTech, B2B",
    scope: "Branding, Design System, Mascot",
    image: "/img/cc.jpg",
    href: "/crowd-control",
  },
  {
    title: "Zvuk Business",
    niche: "MarTech, B2B",
    scope: "Branding, Design System, Illustrations",
    image: "/img/zvuk.jpg",
    href: "/zvuk",
  },
];

const actualCases = [];

for (const item of cases) {
  if (item.href != Astro.url.pathname) {
    actualCases.push(item);
  }
}
---

<div class="container">
  {
    actualCases.map((item) => (
      <a href={item.href} class="case-thumbnail">
        <div class="case-cover">
          <img src={item.image} alt={item.title} />
        </div>
        <div class="case-details">
          <div>
            <div class="case-title">{item.title}</div>
            <div class="case-niche">{item.niche}</div>
          </div>
          <div>
            <div class="case-scope">{item.scope}</div>
          </div>
        </div>
      </a>
    ))
  }
</div>

<style>
  .container{
    display: grid;
    grid-template-columns: repeat(3,1fr);
  }

  .case-thumbnail {
    display: flex;
    flex-direction: column;
    cursor: pointer;
    border: 1px solid black;
    overflow: hidden;
    font-family: var(--font-inter);
    text-decoration: none;
    color: inherit;
  }

  .case-details {
    display: flex;
    flex-direction: column;
    padding: 1rem;
  }

  .case-cover {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .case-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-title {
    font-family: var(--font-fredoka);
    text-transform: uppercase;
    font-weight: 700;
    font-size: 1.5rem;
  }
</style>
