---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectImage from '../components/ProjectImage.astro';
import InstagramGallery from '../components/InstagramGallery.astro';
import { ArrowUpRight } from '@lucide/astro';
import projects from '../data/projects.json';
import profile from '../data/profile.json';
const showreelUrl = `https://www.youtube.com/embed/${profile.showreelId}?autoplay=1&mute=1&controls=1&rel=0&loop=1&playlist=${profile.showreelId}&playsinline=1`;
const featured = ['cryptonix', 'incentive-performance', 'zvuk', 'incentive-ugc', 'cryptonix-sales', 'crowd-control'].map(id => projects.find(p => p.id === id)!);
---
<Layout>
  <section class="hero wrap">
    <div class="hero-body">
      <div class="hero-copy">
        <h1>Brand design.<br />Art direction.<br />CreativeOps.</h1>
        <p class="hero-description">I build brands and the systems that help teams deliver them.</p>
        <a class="pill" href="#work">Selected work</a>
      </div>
      <div class="showreel">
        <div class="showreel-player"><ProjectImage name="cryptonix-stand-cd386391.webp" alt="" eager={true} /><iframe id="showreel" title="Grigorii Khralenok — design showreel" src={showreelUrl} allow="autoplay; encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
      </div>
    </div>
  </section>
  <section id="work" class="work-section wrap">
    <div class="section-heading"><h2>Selected work</h2></div>
    <div class="project-grid">{featured.map((project, i) => <ProjectCard project={project} number={i + 1} />)}</div>
  </section>
  <section id="about" class="about-section"><div class="wrap">
    <div class="approach-layout"><div class="approach-copy">
      <h2>Direction, design, delivery.</h2>
      <div class="about-intro">{profile.bio.map(paragraph => <p>{paragraph}</p>)}</div>
      <div class="capabilities">
        <div><h3>Creative direction</h3><p>Concept development, art direction, and team leadership.</p></div>
        <div><h3>Brand & digital</h3><p>Visual systems, websites, illustration, motion, and campaigns.</p></div>
        <div><h3>CreativeOps</h3><p>Templates, components, production workflows, and practical automation.</p></div>
      </div>
    </div><img class="workflow-illustration" src="/character.png" alt="Illustration of a creative production workflow" width="440" height="440" loading="lazy" /></div>
  </div></section>
  <div class="personal-art-section wrap"><InstagramGallery id="personal-art" title={profile.personalArt.title} description={profile.personalArt.description} account={profile.personalArt.account} profileUrl={profile.personalArt.url} videos={profile.personalArt.posts} /></div>
  <section id="writing" class="writing-section wrap">
    <div class="section-heading"><h2>Writing</h2><a class="icon-link" href={profile.substack} target="_blank" rel="noopener noreferrer">Substack <ArrowUpRight size={18} aria-hidden="true" /></a></div>
    <div class="writing-list">{profile.writing.map(article => <a href={article.url} target="_blank" rel="noopener noreferrer"><h3>{article.title}</h3><ArrowUpRight size={24} aria-hidden="true" /></a>)}</div>
  </section>
  <script>
    const video = document.querySelector<HTMLIFrameElement>('#showreel');
    if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const url = new URL(video.src); url.searchParams.set('autoplay', '0'); video.src = url.toString();
    }
  </script>
</Layout>
