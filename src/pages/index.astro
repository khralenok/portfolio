---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import InstagramGallery from '../components/InstagramGallery.astro';
import { ArrowUpRight } from '@lucide/astro';
import projects from '../data/projects.json';
import profile from '../data/profile.json';
const featured = projects;
---
<Layout>
  <section id="work" class="work-section wrap" aria-labelledby="work-heading">
    <div class="work-heading"><h1 id="work-heading">Illustration, design &amp; creative production.</h1></div>
    <div class="project-grid">{featured.map((project, i) => <ProjectCard project={project} number={i + 1} />)}</div>
    <div class="work-cta">
      <div><h2>Have a project in mind?</h2><p>Illustrations, campaign visuals, and creative support from the first idea to the finished work.</p></div>
      <a class="pill" href={`mailto:${profile.email}`}>Let’s talk <ArrowUpRight size={18} aria-hidden="true" /></a>
    </div>
  </section>
  <section id="about" class="about-section"><div class="wrap">
    <div class="approach-layout"><div class="approach-copy">
      <h2>From idea to finished work.</h2>
      <div class="about-intro">{profile.bio.map(paragraph => <p>{paragraph}</p>)}</div>
      <div class="capabilities">
        <div><h3>Creative direction</h3><p>A clear concept, a visual direction, and a shared understanding of what we’re making.</p></div>
        <div><h3>Illustration & design</h3><p>Editorial illustrations, characters, and visual systems for brands and campaigns.</p></div>
        <div><h3>Creative production</h3><p>Hands-on design, creator coordination, and practical workflows that keep projects moving.</p></div>
      </div>
    </div><img class="workflow-illustration" src="/character.png" alt="Illustration of a creative production workflow" width="440" height="440" loading="lazy" /></div>
  </div></section>
  <div class="personal-art-section wrap"><InstagramGallery id="personal-art" title={profile.personalArt.title} description={profile.personalArt.description} account={profile.personalArt.account} profileUrl={profile.personalArt.url} videos={profile.personalArt.posts} /></div>
  <section id="writing" class="writing-section wrap">
    <div class="section-heading"><h2>Writing</h2><a class="icon-link" href={profile.substack} target="_blank" rel="noopener noreferrer">Substack <ArrowUpRight size={18} aria-hidden="true" /></a></div>
    <div class="writing-list">{profile.writing.map(article => <a href={article.url} target="_blank" rel="noopener noreferrer"><h3>{article.title}</h3><ArrowUpRight size={24} aria-hidden="true" /></a>)}</div>
  </section>

</Layout>

<style>
  .work-section { padding-top:36px; padding-bottom:64px; }
  .work-heading { margin-bottom:32px; }
  h1 { font-size:var(--type-h2); line-height:1.12; max-width:25ch; }
  .work-cta { display:flex; justify-content:space-between; align-items:center; gap:32px; margin-top:56px; padding:32px; background:color-mix(in srgb,var(--accent) 24%,var(--paper)); border:1px solid var(--line); border-radius:5px; }
  .work-cta h2 { font-size:var(--type-h3); margin-bottom:12px; }
  .work-cta p { color:var(--muted); max-width:48ch; }
  .work-cta .pill { flex-shrink:0; gap:16px; margin-top:0; }
  @media(max-width:700px) {
    .work-section { padding-top:28px; padding-bottom:40px; }
    h1 { font-size:calc(var(--type-body) * 1.777778); }
    .work-heading { margin-bottom:24px; }
    .work-cta { flex-direction:column; align-items:flex-start; margin-top:40px; padding:24px; gap:24px; }
  }
</style>
