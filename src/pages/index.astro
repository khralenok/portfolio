---
import BaseLayout from "../layouts/BaseLayout.astro";
import Cases from "../components/Cases.astro";
import { NotepadText } from "@lucide/astro";
---

<BaseLayout
  title="Brand Designer"
  description="Portfolio of Grigorii Khralenok, brand and creative designer."
>
  <section id="hero" class="large">
    <div id="illustration">
      <img src="/img/hero-illustration.svg" alt="A character peeking over the hero panel" />
    </div>
    <div class="hero-text">
      <div id="title">
        <h1>
          <span id="h1-1">Looking for</span>
          <span id="h1-2">a graphic designer?</span>
        </h1>
      </div>
      <div id="subtitle">
        You found one. Hi, I’m Grigorii Khralenok. I design brand communications
        and build systems and automations that make the work behind it run
        smoothly.
      </div>
      <div class="btns-wrapper center">
        <a class="btn" href="#cases">Explore cases</a>
      </div>
    </div>
  </section>
  <section id="workflow">
    <div class="section-description">
      <h2>How I work</h2>
      <p>
        AI makes design faster, but not automatically better. Generated visuals
        drift off-brand, while manual production still takes time. My approach
        is simple: design first, systemize what works, automate what repeats.
      </p>
    </div>
    <div id="image">
      <img src="/img/workflow-illustration.png" width="320" height="320" alt="Design workflow illustration" />
    </div>
    <div id="cards">
      <div class="card">
        <div class="number">1</div>
        <h3>Design the real work</h3>
        <p>
          I learn the brand through real communication work, balancing its
          audience, goals, constraints and team needs before defining a direction.
        </p>
      </div>
      <div class="card">
        <div class="number">2</div>
        <h3>Build the visual system</h3>
        <p>
          I turn the proven visual language into practical rules and reusable
          patterns, keeping everyday production fast, clear and consistent.
        </p>
      </div>
      <div class="card">
        <div class="number">3</div>
        <h3>Automate repeatable work</h3>
        <p>
          I automate stable, repetitive production with TypeScript, Figma APIs
          and AI tools, while keeping creative decisions deliberate and editable.
        </p>
      </div>
    </div>
  </section>
  <section id="cases">
    <div class="section-heading">
      <h2>Case studies</h2>
      <p>
        Selected identity systems and creative work built to stay consistent
        across real teams, channels and production demands.
      </p>
    </div>
    <Cases />
  </section>
  <section id="knowhow">
    <div class="section-description">
      <h2>Know-how</h2>
      <p>
        I’m constantly learning new things and collecting them into notes. Here
        are a few ideas you might find useful.
      </p>
      <div class="btns-wrapper">
        <a class="btn">Explore more</a>
      </div>
    </div>
    <ul>
      <li>
        <NotepadText />
        <a href="/">On-brand carousel mass production</a>
      </li>
      <li>
        <NotepadText />
        <a href="/">Blog article infographics mass-production</a>
      </li>
      <li>
        <NotepadText />
        <a href="/">Batch covers generation</a>
      </li>
      <li>
        <NotepadText />
        <a href="/">Data-structures for automatization</a>
      </li>
      <li>
        <NotepadText />
        <a href="/">Data-driven comparison graphic production</a>
      </li>
      <li>
        <NotepadText />
        <a href="/">How to keep AI generation editable</a>
      </li>
    </ul>
  </section>
  <section id="faq">
    <div class="section-heading">
      <h2>FAQ</h2>
      <p>
        A little more about my experience, working style and collaborating
        across distributed teams.
      </p>
    </div>
    <div class="faq-container">
      <details class="faq-item" name="faq">
        <summary class="faq-question">Who is Grigorii?</summary>
        <div class="faq-answer">
          <p>
            Grigorii is a brand designer with 10 years of experience creating
            visual identities, design systems, and marketing materials for B2B
            companies. His work covers websites, presentations, newsletters,
            campaigns, social media, events, and other key brand touchpoints.
          </p>
        </div>
      </details>

      <details class="faq-item" name="faq">
        <summary class="faq-question">Why hire Grigorii?</summary>
        <div class="faq-answer">
          <p>
            He combines strong hands-on design skills with system thinking.
            Beyond creating polished visual work, he builds templates,
            guidelines, and reusable components that help teams maintain quality
            and consistency as the volume of work grows.
          </p>
        </div>
      </details>

      <details class="faq-item" name="faq">
        <summary class="faq-question"
          >What is Grigorii’s strongest quality?</summary
        >
        <div class="faq-answer">
          <p>
            His strongest quality is the ability to turn complex ideas into
            clear visual systems. He looks beyond individual assets and
            considers how typography, layout, hierarchy, motion, and reusable
            design principles work together across the entire brand.
          </p>
        </div>
      </details>

      <details class="faq-item" name="faq">
        <summary class="faq-question"
          >What time zone does Grigorii work in?</summary
        >
        <div class="faq-answer">
          <p>
            Grigorii is based in Vietnam and works in the UTC+7 time zone. He
            can maintain regular overlap with teams in the UK and Europe and is
            comfortable adapting his schedule when projects require closer
            collaboration.
          </p>
        </div>
      </details>

      <details class="faq-item" name="faq">
        <summary class="faq-question"
          >What remote-work experience does Grigorii have?</summary
        >
        <div class="faq-answer">
          <p>
            Grigorii has several years of experience working independently with
            distributed teams, stakeholders, contractors, and clients across
            multiple countries. He is comfortable with asynchronous
            communication, documented workflows, structured handoffs, task
            tracking, and taking ownership of projects without constant
            supervision.
          </p>
        </div>
      </details>
    </div>
  </section>
</BaseLayout>

<style>
  section {
    font-family: var(--font-inter);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
  }

  section:not(.large) {
    width: min(var(--content-width), calc(100% - 2 * var(--page-gutter)));
    margin-block: var(--section-space);
    scroll-margin-top: 2rem;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-fredoka);
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    --block-width: min(76rem, calc(100vw - 2 * var(--page-gutter)));
    width: var(--block-width);
    color: inherit;
    line-height: 1;
    text-transform: uppercase;
  }

  h1 span:nth-child(1) {
    display: block;
    font-size: calc(var(--block-width) * 0.125);
    font-stretch: 103%;
    white-space: nowrap;
  }

  h1 span:nth-child(2) {
    display: block;
    font-size: calc(var(--block-width) * 0.073);
    font-stretch: 105%;
    white-space: nowrap;
  }

  h2,
  h3 {
    line-height: 1.12;
    color: var(--color-accent);
  }

  h2 {
    font-size: clamp(2.25rem, 5vw, 4.2rem);
    margin-bottom: 1rem;
  }

  h3 {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
  }

  #hero {
    width: 100%;
    color: var(--color-neutral-0);
    z-index: 1;
    scroll-margin-top: 2rem;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--color-accent);
    padding: clamp(2.5rem, 6vw, 5rem) var(--page-gutter);
  }

  #illustration {
    position: relative;
    aspect-ratio: 320/66;
    overflow: visible;
    z-index: 10;
  }

  #hero img {
    position: absolute;
    inset: 0;
    width: 100%;
  }

  #title,
  #subtitle {
    display: flex;
    align-items: center;
    text-align: center;
  }

  #title {
    justify-content: center;
  }

  #subtitle {
    width: min(var(--text-width), 100%);
    margin-top: clamp(0.75rem, 1.5vw, 1.25rem);
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: 0;
  }

  .btns-wrapper {
    display: flex;
    gap: 1rem;
  }

  .btns-wrapper > * {
    flex-grow: 0;
  }

  .btns-wrapper.center{
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    padding: 0.875rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-accent);
    background: var(--color-neutral-0);
    box-shadow: var(--color-neutral-100) 0 0.375rem;
    border: 2px solid var(--color-neutral-100);
    transition: box-shadow 160ms ease, transform 160ms ease;
  }

  .btn:hover {
    box-shadow: var(--color-neutral-100) 0 0.625rem;
    transform: translateY(-0.125rem);
  }

  #workflow {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  #cards {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .section-description {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .section-description > p {
    max-width: var(--text-width);
    color: var(--color-muted);
  }

  .section-heading {
    max-width: var(--text-width);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-heading p {
    color: var(--color-muted);
  }

  .number {
    background: var(--color-highlight-strong);
    color: var(--color-neutral-0);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  #image {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #image img {
    width: min(100%, 32rem);
    height: auto;
  }

  .card {
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-tint);
  }

  .card h3 {
    margin-bottom: 0.75rem;
    min-height: 2.24em;
  }

  #knowhow {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(22rem, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  #knowhow ul {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  #knowhow .btns-wrapper {
    margin-top: 1.5rem;
  }

  #knowhow li {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--color-border);
    gap: 1rem;
  }

  #knowhow li :global(svg) {
    flex: 0 0 auto;
    color: var(--color-highlight-strong);
  }

  #knowhow li a {
    color: inherit;
    font-weight: 600;
    text-decoration-color: var(--color-8);
    text-underline-offset: 0.25rem;
  }

  #knowhow li a:hover {
    color: var(--color-accent);
  }

  #knowhow li:first-child a::after {
    content: "new";
    display: inline-flex;
    align-items: center;
    margin-left: 0.625rem;
    padding: 0.125rem 0.45rem;
    border-radius: 999px;
    background: var(--color-6);
    color: var(--color-5);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    vertical-align: 0.125rem;
  }

  .faq-container {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      block-size 280ms ease,
      content-visibility 280ms allow-discrete,
      opacity 220ms ease;
  }

  .faq-item[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  .faq-question {
    padding: 1.25rem 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: "+";
    color: var(--color-accent);
    font-size: 1.75rem;
    line-height: 1;
    margin-left: 1rem;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-question {
    color: var(--color-highlight-strong);
  }

  .faq-item[open] .faq-question::after {
    content: "−";
  }

  .faq-answer {
    max-width: var(--text-width);
    padding: 0 0 1.5rem;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (max-width: 52rem) {

    #workflow,
    #knowhow {
      grid-template-columns: 1fr;
    }

    #workflow {
      gap: 2.5rem;
    }

    #cards {
      grid-template-columns: 1fr;
      margin-top: 0;
    }

    #image {
      grid-row: 2;
    }

    .card h3 {
      min-height: 0;
    }

    #knowhow {
      gap: 2.5rem;
    }
  }

  @media (max-width: 34rem) {
    .hero-text {
      padding-block: 2.25rem 2.75rem;
    }

    #subtitle {
      text-align: left;
    }

    .btn,
    .btns-wrapper {
      width: 100%;
    }

    #illustration {
      min-height: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .faq-item::details-content {
      transition: none;
    }
  }
</style>
